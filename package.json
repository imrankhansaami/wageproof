{
  "name": "wageproof-platform",
  "version": "0.1.0",
  "private": true,
  "description": "WageProof - payroll proof and export-compliance rail for RMG (MVP)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @wageproof/api",
    "start": "npm run start --workspace @wageproof/api",
    "seed": "npm run seed --workspace @wageproof/api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
