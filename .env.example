# Copy to .env to override. All values have safe defaults.

PORT=4000
HOST=0.0.0.0

# Public base URL used in QR codes and receipts.
# For phone testing on your LAN, set this to your machine IP, e.g. http://192.168.0.10:4000
PUBLIC_URL=http://localhost:4000

DB_PATH=./data/wageproof.db

# If set, every write to /api/* requires header:  x-api-key: <token>
# Leave empty for local development.
# ADMIN_TOKEN=change-me
